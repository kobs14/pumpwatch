# PumpWatch Environment Configuration
# Copy this file to .env and fill in the values.

# --- Core ---
# Environment: dev, test, or prod
ENVIRONMENT=dev
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Infrastructure ---
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://pumpwatch:pumpwatch@localhost:5432/pumpwatch
# Redis connection string
REDIS_URL=redis://localhost:6379/0
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=replace-me-with-token-from-botfather

# --- Pump.fun API ---
# Base URL for the Pump.fun frontend API
PUMPFUN_BASE_URL=https://frontend-api.pump.fun
# Max requests per second to Pump.fun
PUMPFUN_RATE_LIMIT_PER_SEC=8
# Max tokens per batch request
PUMPFUN_MAX_BATCH_SIZE=30
# HTTP request timeout in seconds
PUMPFUN_TIMEOUT_SECONDS=10
# Max retry attempts before raising PumpFunUnavailableError
PUMPFUN_MAX_RETRY_ATTEMPTS=5
# User-Agent header sent to Pump.fun
PUMPFUN_USER_AGENT=pumpwatch/0.1 (+https://github.com/kobs14/pumpwatch)

# --- Alerting Defaults ---
# Percentage-point buffer for warning alerts before a threshold is hit
WARNING_BUFFER_PCT_DEFAULT=5.00
# k multiplier for median+MAD volume-spike detector
VOLUME_SPIKE_K_DEFAULT=3.00

# --- Scheduler Priority Tiers (seconds between polls) ---
PRIORITY_TICK_HIGH_SECONDS=3
PRIORITY_TICK_MEDIUM_SECONDS=15
PRIORITY_TICK_LOW_SECONDS=60
# How often Celery Beat triggers fetch_batch (seconds)
SCHEDULER_FETCH_INTERVAL_SECONDS=30
# Toggle the api_call_log write inside PumpFunClient (kill-switch for the
# observability path; sessionmaker must also be passed for logging to occur).
PUMPFUN_LOG_CALLS=true

# --- Worker / Price Ingestion ---
# PriceDataSource the worker instantiates: "pumpfun", "dexscreener", or "fake".
PRICE_SOURCE=pumpfun
# Redis hot-cache TTLs (seconds), one per subscription tier.
PRICE_CACHE_TTL_HIGH_SECONDS=60
PRICE_CACHE_TTL_MEDIUM_SECONDS=300
PRICE_CACHE_TTL_LOW_SECONDS=900

# --- DexScreener (fallback source; ADR #14, ADR #20) ---
DEXSCREENER_BASE_URL=https://api.dexscreener.com
# DexScreener publishes ~300 req/min (= 5/s). Higher values risk 429.
DEXSCREENER_RATE_LIMIT_PER_SEC=5
DEXSCREENER_MAX_BATCH_SIZE=30
DEXSCREENER_TIMEOUT_SECONDS=10
DEXSCREENER_MAX_RETRY_ATTEMPTS=5
DEXSCREENER_USER_AGENT=pumpwatch/0.1 (+https://github.com/kobs14/pumpwatch)
DEXSCREENER_LOG_CALLS=true

# --- Telegram Rate Limits ---
# Max messages per second to a single chat
TELEGRAM_PER_CHAT_MSG_PER_SEC=1
# Max messages per second globally across all chats
TELEGRAM_GLOBAL_MSG_PER_SEC=25

# --- Alert Engine ---
# Median+MAD volume-spike detector window (seconds) and min sample count
# below which the detector skips. 60 min @ 5-min bins ≈ 12 samples baseline.
VOLUME_SPIKE_WINDOW_SECONDS=3600
VOLUME_SPIKE_MIN_SAMPLES=12
# Redis dedup-TTL cooldowns per alert type (seconds).
ALERT_DEDUP_HIT_SECONDS=3600
ALERT_DEDUP_WARNING_SECONDS=300
ALERT_DEDUP_SPIKE_SECONDS=600
# Wait between the first and second Telegram dispatch attempt.
ALERT_DISPATCH_RETRY_DELAY_SECONDS=1.0
# Periodic reconciliation sweep over recently-failed alerts. Suppressed
# rows (ADR #17) are skipped; up to MAX_ATTEMPTS re-dispatches per row.
ALERT_RECONCILE_INTERVAL_SECONDS=300
ALERT_RECONCILE_WINDOW_SECONDS=3600
ALERT_RECONCILE_MAX_ATTEMPTS=1

# --- Worker DLQ + retry ---
# Celery-level retries for fetch_token before the row is upserted into
# the dlq_entries Postgres table. Total HTTP attempts per logical poll
# = (Celery tries) * (PumpFunClient tenacity attempts) = 2 * 5 = 10.
WORKER_FETCH_MAX_CELERY_RETRIES=1
WORKER_FETCH_RETRY_BACKOFF_SECONDS=5

# --- Prometheus / Observability ---
# Per-service /metrics ports. The compose --profile observability stack
# scrapes these. Worker uses prometheus_client multiprocess mode.
METRICS_PORT_BOT=9101
METRICS_PORT_SCHEDULER=9102
METRICS_PORT_WORKER=9103
METRICS_PORT_ALERTS=9104
METRICS_GAUGE_REFRESH_SECONDS=15
PROMETHEUS_MULTIPROC_DIR=/tmp/pumpwatch-metrics
